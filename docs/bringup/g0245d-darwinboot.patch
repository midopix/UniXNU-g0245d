+//
+// g0245d: the only evidence that survives ExitBootServices. Boot services are
+// gone, so this is raw memory work only. A green band means the kernel branch is
+// next; a red band means ExitBootServices itself failed and the loader is about to
+// spin. Both screen edges are painted because SimpleFbDxe scans the buffer
+// bottom-up (mFbFlip) and the GOP protocol does not expose that flag.
+//
+STATIC
+VOID
+PaintBand (IN CONST UINT64 Video[6], IN BOOLEAN Red)
+{
+  UINT8  *Fb;
+  UINTN  Bpp, Stride, Width, Height, Rows, Row, Col, Mirror;
+  UINT8  Pattern[4];
+
+  if ((Video[0] == 0) || (Video[2] == 0) || (Video[3] == 0) || (Video[4] == 0)) { return; }
+  Bpp    = (UINTN)(Video[5] / 8);
+  Stride = (UINTN)Video[2];
+  Width  = (UINTN)Video[3];
+  Height = (UINTN)Video[4];
+  if ((Bpp != 3) && (Bpp != 4)) { return; }
+
+  if (Bpp == 3) {
+    // g0245d's panel stores (G, R, B) per pixel.
+    Pattern[0] = Red ? 0x00 : 0xFF;
+    Pattern[1] = Red ? 0xFF : 0x00;
+    Pattern[2] = 0x00;
+    Pattern[3] = 0x00;
+  } else {
+    // B, G, R, reserved
+    Pattern[0] = 0x00;
+    Pattern[1] = Red ? 0x00 : 0xFF;
+    Pattern[2] = Red ? 0xFF : 0x00;
+    Pattern[3] = 0x00;
+  }
+
+  Fb   = (UINT8 *)(UINTN)Video[0];
+  Rows = Height / 24 + 1;
+  for (Row = 0; Row < Rows; Row++) {
+    for (Col = 0; Col < Width; Col++) {
+      CopyMem (Fb + Row * Stride + Col * Bpp, Pattern, Bpp);
+      Mirror = Height - 1 - Row;
+      CopyMem (Fb + Mirror * Stride + Col * Bpp, Pattern, Bpp);
+    }
+  }
+}
