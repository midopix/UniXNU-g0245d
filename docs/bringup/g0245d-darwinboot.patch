+//
+// g0245d: the boot menu can only show a status name, and everything this driver
+// Prints is painted over when the menu comes back. Park the last failure text in
+// a variable so UniXNU can echo it on the notice line; the loader protocol GUID
+// doubles as the vendor GUID because both modules already have it.
+//
+STATIC BOOLEAN  mDiagSet = FALSE;
+
+STATIC
+VOID
+RecordDiag (IN CONST CHAR16 *Text)
+{
+  //
+  // First message of the attempt wins: the specific one from AllocateWindow is
+  // worth more than the generic "boot refused" at the Fail label.
+  //
+  if (mDiagSet) { return; }
+
+  gRT->SetVariable (
+         L"UniXNUBootDiag",
+         &gUniXNULoaderProtocolGuid,
+         EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+         (StrLen (Text) + 1) * sizeof (CHAR16),
+         (VOID *)Text
+         );
+  mDiagSet = TRUE;
+}
+
+STATIC
+VOID
+ClearDiag (VOID)
+{
+  mDiagSet = FALSE;
+  gRT->SetVariable (L"UniXNUBootDiag", &gUniXNULoaderProtocolGuid, 0, 0, NULL);
 }
 
