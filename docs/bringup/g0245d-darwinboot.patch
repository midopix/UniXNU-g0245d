+    // when the boot menu has already painted over this line.
+    //
+    DEBUG ((DEBUG_ERROR, "DARWINBOOT: loader v2 installed, firmware at EL%u\n",
+            (UINT32)(DarwinCurrentEl () >> 2)));
   }
   return Status;
 }
