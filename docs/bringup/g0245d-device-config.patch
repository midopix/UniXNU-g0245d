diff --git a/board.toml b/board.toml
index 4174c64..8d1497b 100644
--- a/board.toml
+++ b/board.toml
@@ -57,7 +57,11 @@ DEVICE_MODEL = "g0245d"
 
 [payload]
 volume = "G0245D"
-size_mib = 192
+# 2026-11-09: 24 MiB — the payload rides in boot.img's ramdisk slot, and the
+# stock boot partition is at most ~64 MiB (kernel slot alone is ~31.6 MB).
+# Content is 18.3 MB (kernel.macho + adt + unixnu.toml), well under the
+# 0.95 * size guard.
+size_mib = 24
 loader = "firmware"
 title = "UniXNU"
 # Stock boot.img (Android v0 header) facts, parsed by scripts/extract-files.py:
diff --git a/patches/xnu/series b/patches/xnu/series
index 7535c88..8bf8eaf 100644
--- a/patches/xnu/series
+++ b/patches/xnu/series
@@ -11,3 +11,10 @@
 # EPERM whenever the export headers are regenerated. Ignoring the timestamp
 # failure keeps the installed bytes and mode intact.
 zzz-g0245d-linux-installfile-futimes.patch
+
+# G0245D bring-up: three solid white bands painted into the firmware framebuffer
+# from osfmk/arm64/start.s while the MMU is still off (stage 0 = entered
+# start_first_cpu, 1 = bootstrap page tables built, 2 = about to enable the MMU).
+# This board has no serial console and the tree has no arm64 framebuffer console,
+# so counting the bands is the only way to see how far the kernel gets.
+zzz-g0245d-early-boot-marks.patch
