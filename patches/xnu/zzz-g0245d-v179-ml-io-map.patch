diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -733,6 +733,56 @@
 	}
 
 	/*
+	 * G0245D v179: single suspect - can ml_io_map() give us a framebuffer VA
+	 * that is still valid AFTER arm_vm_init()?
+	 *
+	 * v177 painted six WHITE bars through the loader identity VA 0xC3401000
+	 * BEFORE arm_vm_init and all six appeared (brush + row geometry are good).
+	 * v178 used that SAME VA right AFTER arm_vm_init and the bars stayed white:
+	 * the loader PT is recycled when TTBR0 is swapped, so that VA is dead.
+	 *
+	 * MSM8998 (cheeseburger) proved the fix: immediately after arm_vm_init()
+	 * returns, call the PLAIN ml_io_map() (NOT ml_io_map_unmappable /
+	 * ml_io_map_wcomb - those were the v155/v170 dead ends that failed
+	 * silently under SPTM) and write through the VA it returns. ml_io_map() is
+	 * declared in <machine/machine_routines.h>, already included at the top of
+	 * this file, so no new header is needed here.
+	 *
+	 * Geometry: fb phys 0x83401000, stride 0xCA8, 24bpp. The six marks sit at
+	 * rows 700+45*i (i=0..5), 30 rows tall => the last byte we touch is row
+	 * 954. Mapping 973 rows from the fb base reaches through row 972; rounded
+	 * up to a 4KB page that is 0x302000 bytes (~3MB), far below the 0x1000000
+	 * upper bound used by the MSM8998 reference.
+	 *
+	 * READOUT (the same six bars v177/v178 used):
+	 *   bars turn BLACK -> ml_io_map works after arm_vm_init. Next step: move
+	 *                      all progress marks onto this VA (direct stores).
+	 *   bars stay WHITE -> ml_io_map also fails to yield a usable VA. Next
+	 *                      step: copy pagani's SWE00-03 probe - add a kprintf
+	 *                      inside ml_io_map() in osfmk/arm/io_map.c to find
+	 *                      out whether it stalls at kmem_alloc or pmap_map.
+	 */
+	{
+		volatile unsigned int *fb;
+		vm_offset_t           fb_va;
+		int                   i;
+		unsigned long         k;
+
+		fb_va = ml_io_map((vm_offset_t)0x83401000UL,
+		    (vm_size_t)0x302000UL);
+		if (fb_va != 0) {
+			for (i = 0; i < 6; i++) {
+				fb = (volatile unsigned int *)(unsigned long)
+				    ((unsigned long)fb_va +
+				     (unsigned long)(700 + i * 45) * 0xCA8UL);
+				for (k = 0; k < (30UL * 0xCA8UL / 4UL); k++) {
+					fb[k] = 0x00000000U;
+				}
+			}
+		}
+	}
+
+	/*
 	 * G0245D v173: v172's permanent TTBR1 framebuffer slot is proven working -
 	 * its row 700..972 solid block lit up on the panel. Drop that block now so
 	 * the six g0245d_fb_mark() bars in startup.c (rows 700+45*i, 30 rows tall)
