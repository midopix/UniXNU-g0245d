diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
index 4c1edf1..f33222d 100644
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -3301,3 +3301,32 @@ vc_set_progressmeter(int new_value)
 }
 
 #endif /* defined(XNU_TARGET_OS_OSX) */
+
+
+/* G0245D v142: paint white progress bands through the video console's own
+ * mapped framebuffer VA (vinfo.v_baseaddr) - the exact VA the console clears
+ * with, so it is guaranteed mapped, unlike the physmap VA v140 tried (faulted).
+ * Repaints 13..index each call so console clears between steps stay visible. */
+void
+g0245d_vc_paint(int index)
+{
+	unsigned char *base;
+	unsigned long bytes, row;
+	int i, k, h;
+
+	if (!vinfo.v_baseaddr || !vinfo.v_rowbytes || !vinfo.v_height) {
+		return;
+	}
+	base  = (unsigned char *)(uintptr_t)vinfo.v_baseaddr;
+	bytes = (unsigned long)vinfo.v_rowbytes;
+	for (k = 13; k <= index; k++) {
+		row = 700UL + 32UL * (unsigned long)(k - 13);
+		h   = 16;
+		if (row + (unsigned long)h > (unsigned long)vinfo.v_height) {
+			continue;
+		}
+		for (i = 0; i < h; i++) {
+			memset(base + (row + (unsigned long)i) * bytes, 0xFF, bytes);
+		}
+	}
+}
