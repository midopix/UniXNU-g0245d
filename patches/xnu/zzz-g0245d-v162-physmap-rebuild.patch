diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -657,15 +657,51 @@
 
 	arm_vm_init(xmaxmem, args);
 
+	/*
+	 * G0245D v162: rebuild a usable mapping after the TTBR0 swap.
+	 *
+	 * v161 settled the question decisively: flooding rows 200..680 white
+	 * BEFORE arm_vm_init painted a solid block on the panel (photo proof), and
+	 * the same flood in black AFTER it changed nothing. So the loader V=P
+	 * window at 0xC3401000 - the only mapping that ever reached this panel -
+	 * dies in arm_vm_init, and everything after it needs a mapping we build
+	 * ourselves.
+	 *
+	 * v156 tried pmap_map_bd but then painted through the ml_io_map address
+	 * instead of the physmap address it had just mapped, so the mapping was
+	 * never actually exercised. v162 maps the splash range and paints through
+	 * EXACTLY that VA, then flushes the data cache, because physmap is Normal
+	 * cacheable while the panel is fed by MDP5 DMA straight out of DRAM - the
+	 * stores would otherwise sit in cache and MDP5 would never see them.
+	 *
+	 * Two blocks will be on screen if this works:
+	 *   rows 200..680  white  (v161 step 1 - proof we reached arm_vm_init)
+	 *   rows 700..972  white  (v162 - proof physmap now reaches the panel)
+	 * Only the lower block means the mapping still fails.
+	 */
 	{
-		volatile unsigned int *fb;
+		extern vm_map_address_t pmap_map_bd(vm_map_address_t va, vm_offset_t sa,
+		    vm_offset_t ea, vm_prot_t prot);
+		extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+		extern unsigned long gVirtBase;
+		extern unsigned long gPhysBase;
+		const unsigned long fb_pa = 0x83401000UL;
+		const unsigned long fb_sz = 0x23ff000UL;
+		unsigned long va = gVirtBase + (fb_pa - gPhysBase);
+		volatile unsigned int *p;
 		unsigned long n;
 
-		fb = (volatile unsigned int *)(unsigned long)(0xC3401000UL + 200UL * 0xCA8UL);
-		for (n = 0; n < (480UL * 0xCA8UL / 4UL); n++) {
-			fb[n] = 0x00000000U;
+		pmap_map_bd((vm_map_address_t)va, (vm_offset_t)fb_pa,
+		    (vm_offset_t)(fb_pa + fb_sz), VM_PROT_READ | VM_PROT_WRITE);
+
+		p = (volatile unsigned int *)(unsigned long)(va + 700UL * 0xCA8UL);
+		for (n = 0; n < (272UL * 0xCA8UL / 4UL); n++) {
+			p[n] = 0xFFFFFFFFU;
 		}
 
+		FlushPoC_DcacheRegion((vm_offset_t)(va + 700UL * 0xCA8UL),
+		    (size_t)(272UL * 0xCA8UL));
+
 		for (;;) {
 			__asm__ __volatile__("wfe");
 		}
