diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -674,10 +674,41 @@
 	arm_vm_init(xmaxmem, args);
 
 	/*
-	 * No halt here any more. v164 froze the kernel at this point to prove the
-	 * borrowed table could paint; that is established, so let it run and let
-	 * the marks in machine_startup report how far it gets.
+	 * G0245D v169: paint rows 700..972 white through the borrowed loader table
+	 * (exactly what v164 proved works) but WITHOUT halting this time. The point
+	 * is to leave something on the panel that we can watch while the kernel
+	 * runs on, so that a later halt shows whether the MMSS replay revived MDP5.
 	 */
+	{
+		extern uint64_t g0245d_ttbr0_loader;
+		uint64_t ttbr0_now = 0;
+
+		__asm__ __volatile__("mrs %0, ttbr0_el1" : "=r"(ttbr0_now));
+
+		__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(g0245d_ttbr0_loader) : "memory");
+		__asm__ __volatile__("dsb sy" ::: "memory");
+		__asm__ __volatile__("isb" ::: "memory");
+		__asm__ __volatile__("tlbi vmalle1" ::: "memory");
+		__asm__ __volatile__("dsb sy" ::: "memory");
+		__asm__ __volatile__("isb" ::: "memory");
+
+		{
+			volatile unsigned int *p = (volatile unsigned int *)(unsigned long)
+			    (0xC3401000UL + 700UL * 0xCA8UL);
+			unsigned long n;
+
+			for (n = 0; n < (272UL * 0xCA8UL / 4UL); n++) {
+				p[n] = 0xFFFFFFFFU;
+			}
+		}
+
+		__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(ttbr0_now) : "memory");
+		__asm__ __volatile__("dsb sy" ::: "memory");
+		__asm__ __volatile__("isb" ::: "memory");
+		__asm__ __volatile__("tlbi vmalle1" ::: "memory");
+		__asm__ __volatile__("dsb sy" ::: "memory");
+		__asm__ __volatile__("isb" ::: "memory");
+	}
 
 	if (debug_boot_arg) {
 		patch_low_glo();
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -781,8 +781,21 @@
 	 */
 	{
 		extern void g0245d_mmss_recover(void);
+		extern void g0245d_halt(void);
 
 		g0245d_mmss_recover();
+
+		/*
+		 * G0245D v169: freeze here. v168 ran the same recovery and still went
+		 * black, but without a halt we could not tell whether the replay did
+		 * anything - the kernel simply carried on and the panel died at some
+		 * unknown later point. Freezing removes that ambiguity: if the MMSS
+		 * replay revived MDP5, the two white blocks painted in arm_init are on
+		 * screen right now and stay there; if the panel is black, the replay
+		 * did not bring the display back and the GDSCs had really collapsed
+		 * (so a full mode set is required).
+		 */
+		g0245d_halt();
 	}
 
 #if CONFIG_MACF
