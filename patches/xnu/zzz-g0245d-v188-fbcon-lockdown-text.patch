diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index e6e0d25..c920bd8 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -881,6 +881,38 @@ kernel_bootstrap_thread(void)
 
 	kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN);
 
+	/*
+	 * G0245D v188: framebuffer text console, moved here from arm_init().
+	 *
+	 * g0245d_fbcon_start() reaches the scanout buffer through ml_io_map().
+	 * io_map.c hands out mappings from io_submap, which does not exist until
+	 * STARTUP(KMEM, STARTUP_RANK_LAST, io_map_init) runs - and that happens
+	 * inside kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN) above. In
+	 * arm_init() (the v183 call site) the pmap was up but io_submap was not,
+	 * so the call could only produce a mapping that was never validated: an
+	 * invisible death exactly between fb_mark(2) and fb_mark(3). Here the
+	 * submap exists, so the call should finally work.
+	 *
+	 * This also makes the call a probe: text on the panel means
+	 * kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN) returned; no text
+	 * (with the fb_mark bands still visible) means it died inside.
+	 *
+	 * After registering the fbcon backend, enable the serial console gate and
+	 * switch, so every later kprintf()/printf() lands on the panel too.
+	 * serial_console_enabled gates switch_to_serial_console()
+	 * (osfmk/console/serial_general.c:114) and arm_init() left it FALSE
+	 * because serial_init() enumerated no UART on this board.
+	 */
+	{
+		extern void g0245d_fbcon_start(void);
+		g0245d_fbcon_start();
+	}
+	{
+		extern bool serial_console_enabled;
+		serial_console_enabled = true;
+		(void)switch_to_serial_console();
+	}
+
 	/*
 	 * Get rid of segments used to bootstrap kext loading. This removes
 	 * the KLD, PRELINK symtab, LINKEDIT, and symtab segments/load commands.
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 670cf3c..1f4d5c8 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -789,7 +789,11 @@ extern unsigned char iso_font[256 * 16];
 #define G0245D_FBCON_SCALE  2
 #define G0245D_FBCON_COLS   50
 #define G0245D_FBCON_ROWS   18
-#define G0245D_FBCON_ROW0   40           /* screen row, before the flip */
+/* G0245D v188: ROW0 40 -> 960. The panel scans bottom-up (screen row =
+ * 1919 - fb row), so ROW0 40 lands at fb rows 1303..1895 - outside the only
+ * band range ever proven visible on this panel (fb rows 8..972). ROW0 960
+ * puts the text at fb rows 960..1295, just below the fb_mark family. */
+#define G0245D_FBCON_ROW0   960          /* screen row, before the flip */
 
 static volatile uint8_t *g0245d_fbcon_base;
 static uint32_t g0245d_fbcon_col = 0;
