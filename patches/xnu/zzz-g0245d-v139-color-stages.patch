 void arm_init(boot_args * args);
 
+/*
+ * g0245d v133: paint a band AFTER the bootstrap translation tables are gone.
+ * g0245d_paint_stage() writes VA 0xC3401000, which only exists in the TTBR0
+ * bootstrap (V=P) table; arm_vm_init() switches TTBR0 to invalid_ttep and then
+ * drops the bootstrap tables, so any later write to that VA faults. Route the
+ * post-VM marks through the kernel physmap instead (gVirtBase + pa - gPhysBase).
+ */
+static void
+g0245d_paint_stage_vm(int index)
+{
+	extern vm_offset_t gVirtBase;
+	extern vm_offset_t gPhysBase;
+	const uint64_t fb_pa    = 0x83401000ULL;
+	const uint64_t rowbytes = 0xCA8ULL;
+	uint64_t       va, off, n;
+	uint32_t      *p;
+	int            h;
+
+	off = (uint64_t)((index >= 13) ? (700 + 32 * (index - 13)) : (200 + 64 * index)) * rowbytes;
+	h   = (index >= 13) ? 16 : 32;
+	va  = (uint64_t)gVirtBase + (fb_pa - (uint64_t)gPhysBase);
+	p   = (uint32_t *)(uintptr_t)(va + off);
+	n   = (uint64_t)h * rowbytes / 4;
+	while (n--) {
+		*p++ = 0xFFFFFFFFu;
+	}
+}
+
+/*
+ * g0245d v139: color-coded stage marks.
+ *
+ * v138 (PAN off) no longer freezes on a painted band - the screen goes BLACK
+ * after handoff. That is ambiguous: either XNU still dies earlier (nothing
+ * painted), or it ran much further and something (PE_create_console / vc)
+ * cleared the framebuffer. The cumulative band scheme cannot tell the two
+ * apart, so repaint the WHOLE framebuffer with one solid colour per stage:
+ * whatever colour stays on screen is the last stage that actually executed,
+ * and a fully black screen then means "went past the final mark".
+ *
+ *   21 = yellow   (just before arm_vm_init(), still on bootstrap VA)
+ *   22 = red      (arm_vm_init returned)
+ *   23 = green    (serial_init returned)
+ *   24 = blue     (PE_create_console returned)
+ *   25 = white    (about to enter machine_startup)
+ */
+#define G0245D_FB_PA        0x83401000ULL
+#define G0245D_FB_ROWBYTES  0xCA8ULL
+#define G0245D_FB_ROWS      1920ULL
+
+/*
+ * NOTE: the panel is RGB888 (24bpp, 3 bytes per pixel), NOT 32bpp. Writing
+ * 32-bit words only looks right for white (all 0xFF); for any other colour the
+ * extra byte shifts the pixel grid and the screen shows a cycling
+ * yellow/magenta/cyan stripe pattern instead of a solid colour. So fill one
+ * 3-byte (B,G,R) triplet per pixel.
+ */
+static void
+g0245d_fill_fb(uint64_t fb_va, uint32_t color)
+{
+	uint8_t *p = (uint8_t *)(uintptr_t)fb_va;
+	uint8_t  b = (uint8_t)(color & 0xFFu);
+	uint8_t  g = (uint8_t)((color >> 8) & 0xFFu);
+	uint8_t  r = (uint8_t)((color >> 16) & 0xFFu);
+	uint64_t n = (G0245D_FB_ROWS * G0245D_FB_ROWBYTES) / 3;
+
+	while (n--) {
+		*p++ = b;
+		*p++ = g;
+		*p++ = r;
+	}
+}
+
+static uint32_t
+g0245d_stage_color(int index)
+{
+	switch (index) {
+	case 21: return 0xFFFFFF00u;  /* yellow */
+	case 22: return 0xFFFF0000u;  /* red    */
+	case 23: return 0xFF00FF00u;  /* green  */
+	case 24: return 0xFF0000FFu;  /* blue   */
+	default: return 0xFFFFFFFFu;  /* white  */
+	}
+}
+
+/* Before arm_vm_init(): framebuffer lives at its bootstrap VA (V=P window). */
+static void
+g0245d_mark_va(int index)
+{
+	extern void g0245d_paint_stage(int index);
+
+	g0245d_fill_fb(0xC3401000ULL, g0245d_stage_color(index));
+	g0245d_paint_stage(index);
+}
+
+/* After arm_vm_init(): reach the framebuffer through the kernel physmap. */
+static void
+g0245d_mark_vm(int index)
+{
+	extern vm_offset_t gVirtBase;
+	extern vm_offset_t gPhysBase;
+	uint64_t va;
+
+	va = (uint64_t)gVirtBase + (G0245D_FB_PA - (uint64_t)gPhysBase);
+	g0245d_fill_fb(va, g0245d_stage_color(index));
+	g0245d_paint_stage_vm(index);
+}
+
