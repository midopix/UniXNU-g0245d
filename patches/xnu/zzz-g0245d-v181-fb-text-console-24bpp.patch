Subject: [PATCH] g0245d v181: framebuffer text console at 24bpp

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -747,6 +747,173 @@
 	gPESF = fns;
 }
 
+/*****************************************************************************/
+/*
+ * G0245D v181: framebuffer text console, 24bpp.
+ *
+ * v180 mapped the framebuffer and drew with uint32_t stores. The DARWINBOOT
+ * trace printed on the panel says:
+ *     DARWINBOOT: video base=0x83401000 display=1 row=3240 width=1080
+ *                 height=1920 depth=24
+ * so a pixel is exactly 3 bytes and stride 3240 == 1080 * 3 with no padding.
+ * A 32bpp store therefore wrote the repeating byte pattern 00 00 00 ff, which
+ * shows up as black/blue/green/red vertical stripes instead of glyphs. This
+ * revision addresses every pixel as 3 separate bytes.
+ *
+ * Unchanged from v180: the proven ml_io_map() path (ml_io_map_wcomb and
+ * ml_io_map_unmappable were the v155/v170 dead ends), and pure stores only --
+ * no allocation, no MMIO, never blocks, so it is safe to call from serial_init
+ * before arm_vm_init has switched TTBR0.
+ *
+ * Text occupies the lower panel: rows G0245D_FBCON_ROW0..ROW0+17, i.e.
+ * y = 1280..1856 of 1920, x = 0..800 of 1080.
+ */
+extern unsigned char iso_font[256 * 16];
+
+#define G0245D_FBCON_SCALE   2
+#define G0245D_FBCON_PA      0x83401000UL
+#define G0245D_FBCON_SIZE    0x200000UL
+#define G0245D_FBCON_STRIDE  0xCA8UL     /* 3240 == 1080 px * 3 bytes */
+#define G0245D_FBCON_BPP     3
+#define G0245D_FBCON_COLS    50
+#define G0245D_FBCON_ROWS    18
+#define G0245D_FBCON_ROW0    40
+
+static volatile uint8_t *g0245d_fbcon_base;
+static uint32_t g0245d_fbcon_col = 0;
+static uint32_t g0245d_fbcon_row = 0;
+
+static void
+g0245d_fbcon_px(uint32_t x, uint32_t y, uint8_t b, uint8_t g, uint8_t r)
+{
+	volatile uint8_t *p = g0245d_fbcon_base +
+	    (unsigned long)y * G0245D_FBCON_STRIDE +
+	    (unsigned long)x * G0245D_FBCON_BPP;
+
+	p[0] = b;
+	p[1] = g;
+	p[2] = r;
+}
+
+static void
+g0245d_fbcon_blank_row(uint32_t row)
+{
+	uint32_t y;
+	uint32_t y0 = (G0245D_FBCON_ROW0 + row) * 16U * G0245D_FBCON_SCALE;
+
+	for (y = y0; y < y0 + 16U * G0245D_FBCON_SCALE; y++) {
+		uint32_t x;
+		for (x = 0; x < G0245D_FBCON_COLS * 8U * G0245D_FBCON_SCALE; x++) {
+			g0245d_fbcon_px(x, y, 0, 0, 0);
+		}
+	}
+}
+
+static void
+g0245d_fbcon_newline(void)
+{
+	g0245d_fbcon_col = 0;
+	g0245d_fbcon_row = (g0245d_fbcon_row + 1U) % G0245D_FBCON_ROWS;
+	g0245d_fbcon_blank_row(g0245d_fbcon_row);
+	g0245d_fbcon_blank_row((g0245d_fbcon_row + 1U) % G0245D_FBCON_ROWS);
+}
+
+static void
+g0245d_fbcon_init(void)
+{
+	uint32_t r;
+
+	g0245d_fbcon_col = 0;
+	g0245d_fbcon_row = 0;
+	for (r = 0; r < G0245D_FBCON_ROWS; r++) {
+		g0245d_fbcon_blank_row(r);
+	}
+}
+
+static unsigned int
+g0245d_fbcon_ready(void)
+{
+	return 1;
+}
+
+static void
+g0245d_fbcon_putc(uint8_t c)
+{
+	const unsigned char *glyph;
+	uint32_t x0, y0, gy, gx, sy, sx;
+
+	if (g0245d_fbcon_base == NULL) {
+		return;
+	}
+	if (c == '\r') {
+		g0245d_fbcon_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		g0245d_fbcon_newline();
+		return;
+	}
+	if (c < 0x20U || c > 0x7eU) {
+		c = (uint8_t)'?';
+	}
+	if (g0245d_fbcon_col >= G0245D_FBCON_COLS) {
+		g0245d_fbcon_newline();
+	}
+
+	glyph = iso_font + (uint32_t)c * 16U;
+	x0 = g0245d_fbcon_col * 8U * G0245D_FBCON_SCALE;
+	y0 = (G0245D_FBCON_ROW0 + g0245d_fbcon_row) * 16U * G0245D_FBCON_SCALE;
+
+	for (gy = 0; gy < 16U; gy++) {
+		/* iso_font rows are MSB-leftmost: bit 7 is the leftmost pixel. */
+		uint8_t bits = glyph[gy];
+		for (gx = 0; gx < 8U; gx++) {
+			uint8_t on = (bits & (uint8_t)(0x80U >> gx)) ? 0xffU : 0x00U;
+			for (sy = 0; sy < G0245D_FBCON_SCALE; sy++) {
+				for (sx = 0; sx < G0245D_FBCON_SCALE; sx++) {
+					g0245d_fbcon_px(x0 + gx * G0245D_FBCON_SCALE + sx,
+					    y0 + gy * G0245D_FBCON_SCALE + sy,
+					    on, on, on);
+				}
+			}
+		}
+	}
+	g0245d_fbcon_col++;
+}
+
+static unsigned int
+g0245d_fbcon_recv_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+g0245d_fbcon_recv_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) g0245d_fbcon_serial_functions =
+{
+	.init = g0245d_fbcon_init,
+	.transmit_ready = g0245d_fbcon_ready,
+	.transmit_data = g0245d_fbcon_putc,
+	.receive_ready = g0245d_fbcon_recv_ready,
+	.receive_data = g0245d_fbcon_recv_data,
+	.device = SERIAL_G0245D_FBCON
+};
+
+static void
+g0245d_fbcon_probe(void)
+{
+	g0245d_fbcon_base = (volatile uint8_t *)(uintptr_t)
+	    ml_io_map((vm_offset_t)G0245D_FBCON_PA, (vm_size_t)G0245D_FBCON_SIZE);
+	if (g0245d_fbcon_base != NULL) {
+		g0245d_fbcon_init();
+		register_serial_functions(&g0245d_fbcon_serial_functions);
+	}
+}
+
 #if HIBERNATION
 /**
  * Transitions the serial driver into a mode that can be run in the hibernation
@@ -798,6 +965,9 @@
 	uint32_t const  *prop_value __unused = NULL;
 
 	struct pe_serial_functions *fns = gPESF;
+
+	/* G0245D v181: register the framebuffer text console first. */
+	g0245d_fbcon_probe();
 
 	/**
 	 * Even if the serial devices have already been initialized on cold boot,
diff --git a/pexpert/pexpert/arm/protos.h b/pexpert/pexpert/arm/protos.h
--- a/pexpert/pexpert/arm/protos.h
+++ b/pexpert/pexpert/arm/protos.h
@@ -47,7 +47,8 @@
 	SERIAL_DOCKCHANNEL=0x2,
 	SERIAL_PI3_UART=0x4,
 	SERIAL_VMAPPLE_UART=0x8,
-	SERIAL_DCC_UART=0x10
+	SERIAL_DCC_UART=0x10,
+	SERIAL_G0245D_FBCON=0x40
 } serial_device_t;
 
 kern_return_t serial_irq_enable(serial_device_t device);
