diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -3402,23 +3402,46 @@
 	 * bars is the furthest mark reached. Rows 700 + 45*i with 30-row bars stay
 	 * inside 700..972, the range the old bootstrap bands proved writable.
 	 */
-	extern vm_offset_t g0245d_fb_va;
-	const uint64_t rowbytes = 0xCA8ULL;   /* 1080 px * 3 bytes (24bpp) */
+	uint64_t ttbr0_now;
 	int      i;
 
-	if ((g0245d_fb_va == 0) || (n <= 0)) {
+	/* G0245D v176: the v172 TTBR1 fb slot never actually installed -
+	 * arm_vm_init maps dynamic_memory_begin..VM_MAX_KERNEL_ADDRESS over the
+	 * slot address, so the "all L2 entries empty" guard failed and
+	 * g0245d_fb_va stayed 0 on every version since v172. Go back to the ONLY
+	 * painter with photo proof: borrow the loader's TTBR0 for one swap, paint
+	 * every band through the identity window 0xC3401000, then restore. The
+	 * kernel runs on TTBR1, so this never disturbs execution.
+	 */
+	if ((g0245d_ttbr0_loader == 0) || (n <= 0)) {
 		return;
 	}
+
+	__asm__ __volatile__("mrs %0, ttbr0_el1" : "=r"(ttbr0_now));
+	__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(g0245d_ttbr0_loader) : "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
+	__asm__ __volatile__("tlbi vmalle1" ::: "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
 
 	for (i = 0; i < n; i++) {
 		volatile unsigned int *p = (volatile unsigned int *)(unsigned long)
-		    ((uint64_t)g0245d_fb_va + (uint64_t)(700 + i * 45) * rowbytes);
+		    (0xC3401000UL + (unsigned long)(700 + i * 45) * 0xCA8UL);
 		unsigned long k;
 
 		for (k = 0; k < (30UL * 0xCA8UL / 4UL); k++) {
 			p[k] = 0xFFFFFFFFU;
 		}
 	}
+
+	/* restore arm_vm_init's TTBR0 before returning to the caller */
+	__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(ttbr0_now) : "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
+	__asm__ __volatile__("tlbi vmalle1" ::: "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
 }
 
