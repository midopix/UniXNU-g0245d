diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -655,75 +655,29 @@
 		}
 	}
 
-	uint64_t g0245d_ttbr0_loader = 0;
-
-	__asm__ __volatile__("mrs %0, ttbr0_el1" : "=r"(g0245d_ttbr0_loader));
-
-	arm_vm_init(xmaxmem, args);
-
 	/*
-	 * G0245D v164: borrow the loader's page table back for one write.
-	 *
-	 * v163 ruled out the whole pmap family on this board, for a concrete
-	 * reason: pmap_map_bd_with_options() forwards to sptm_map_page() and
-	 * checks the result with __assert_only, so in a release build a failure is
-	 * SILENT. SPTM is Apple's secure page-table monitor and there is no reason
-	 * to expect it to work on msm8996, so pmap_map_bd / pmap_map_bd_with_options
-	 * can be no-ops here no matter what attributes we ask for.
+	 * G0245D v165: hand the loader's TTBR0 to the framebuffer painter.
 	 *
-	 * That leaves exactly one mapping with photo proof behind it: the loader's
-	 * identity window at 0xC3401000, which v161 painted a solid block through.
-	 * So: save TTBR0 before arm_vm_init swaps it, then - immediately after the
-	 * swap - point TTBR0 back at the loader's table, flush the TLB, paint rows
-	 * 700..972 white through the proven window, restore the kernel table and
-	 * freeze. If the loader's tables survived arm_vm_init this works; if they
-	 * were recycled the write faults and we learn that too.
-	 *
-	 * Two white blocks = the trick works and we can paint at any later point.
-	 * One block (lower only) = the loader tables are gone; we must build our
-	 * own page table walk with raw PTE writes instead.
+	 * v164 proved this works: with TTBR0 pointed back at the loader's own page
+	 * table, a flood of fb rows 700..972 painted a second solid white block on
+	 * the panel. So the table survives arm_vm_init and the identity window at
+	 * 0xC3401000 keeps working - it is purely a matter of which table TTBR0
+	 * currently names. g0245d_fb_mark() now borrows it for every paint, which
+	 * is how the kernel's progress becomes visible again.
 	 */
 	{
-		extern unsigned long gVirtBase;
-		extern unsigned long gPhysBase;
-		uint64_t ttbr0_kernel = 0;
-
-		__asm__ __volatile__("mrs %0, ttbr0_el1" : "=r"(ttbr0_kernel));
-
-		/* Point TTBR0 back at the loader's table and drop stale TLB entries. */
-		__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(g0245d_ttbr0_loader) : "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
-		__asm__ __volatile__("tlbi vmalle1" ::: "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
-
-		/* Paint rows 700..972 through the loader window. */
-		{
-			volatile unsigned int *p =
-			    (volatile unsigned int *)(unsigned long)(0xC3401000UL + 700UL * 0xCA8UL);
-			unsigned long n;
+		extern uint64_t g0245d_ttbr0_loader;
 
-			for (n = 0; n < (272UL * 0xCA8UL / 4UL); n++) {
-				p[n] = 0xFFFFFFFFU;
-			}
-		}
-
-		/* Restore arm_vm_init's table before touching anything else. */
-		__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(ttbr0_kernel) : "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
-		__asm__ __volatile__("tlbi vmalle1" ::: "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
+		__asm__ __volatile__("mrs %0, ttbr0_el1" : "=r"(g0245d_ttbr0_loader));
+	}
 
-		(void)gVirtBase;
-		(void)gPhysBase;
+	arm_vm_init(xmaxmem, args);
 
-		for (;;) {
-			__asm__ __volatile__("wfe");
-		}
-	}
+	/*
+	 * No halt here any more. v164 froze the kernel at this point to prove the
+	 * borrowed table could paint; that is established, so let it run and let
+	 * the marks in machine_startup report how far it gets.
+	 */
 
 	if (debug_boot_arg) {
 		patch_low_glo();
diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -3361,6 +3361,14 @@
 
 
 /*
+ * G0245D v165: TTBR0 as the loader left it, captured by arm_init() before
+ * arm_vm_init() installs the kernel's own tables. Restoring it temporarily is
+ * the only reliable way to write the framebuffer on this board - see the
+ * comment on g0245d_fb_mark() below.
+ */
+uint64_t g0245d_ttbr0_loader;
+
+/*
  * G0245D v149: console-independent framebuffer progress marker.
  *
  * Diagnosis only. Everything the kernel tried to print so far went through the
@@ -3377,46 +3385,59 @@
 void
 g0245d_fb_mark(int n)
 {
-	/* v163: finally a mapping that can actually reach MDP5.
+	/* v165: paint through the loader's own page table.
 	 *
-	 * History: the loader V=P window (0xC3401000) paints the panel, but it
-	 * dies in arm_vm_init (v161 photo: the pre-arm_vm_init flood shows, the
-	 * identical post-arm_vm_init flood does nothing). The kernel physmap
-	 * (gVirtBase+pa-gPhysBase) is Normal cacheable, so stores sit in cache and
-	 * MDP5's DMA never sees them; pmap_map_bd() will not override that existing
-	 * mapping anyway, so it was a no-op.
+	 * Every kernel-side mapping failed and we now know why: the physmap is
+	 * Normal cacheable, so stores never reach DRAM where MDP5's DMA looks;
+	 * ml_io_map_wcomb() produced no pixels; and the pmap_map_bd family
+	 * forwards to sptm_map_page() whose result is checked only by
+	 * __assert_only - silent failure on a board with no SPTM.
 	 *
-	 * ml_io_map_wcomb() allocates a FRESH range in kernel_map and maps it with
-	 * CACHE_ATTRINDX_WRITECOMB (non-cacheable, write-combining) - the correct
-	 * attribute for a DMA-fed framebuffer. Needs kernel_map, so this must only
-	 * be called from machine_startup onward.
+	 * The one mapping with photo proof behind it is the loader's identity
+	 * window at 0xC3401000 (v161 and v164 both painted solid blocks through
+	 * it). arm_init() saves TTBR0 before arm_vm_init() swaps it, so we can
+	 * point TTBR0 back at the loader's table for the duration of a paint and
+	 * then restore. The kernel runs on TTBR1, so this never disturbs
+	 * execution; the TLB has to be invalidated because entries for the
+	 * swapped-out table are stale.
 	 *
-	 * Bands are cumulative: mark(n) draws bands 1..n, so the number of white
-	 * bars on screen is the furthest mark the kernel reached. Row placement
-	 * stays inside 700..1000, the range the old bands proved writable.
+	 * Bands are cumulative and each call does ONE swap: mark(n) draws bands
+	 * 1..n, so the number of white bars is the furthest mark reached. Bands
+	 * live at rows 700 + 45*i, 30 rows tall, which keeps the last one (925)
+	 * inside the 700..972 range the old bands proved writable.
 	 */
-	const uint64_t fb_pa    = 0x83401000ULL;
-	const uint64_t fb_size  = 0x23ff000ULL;
-	const uint64_t rowbytes = 0xCA8ULL;   /* 1080 px * 3 bytes (24bpp) */
-	static uint64_t fb_va   = 0;
-	unsigned int   i;
+	uint64_t ttbr0_now;
+	int      i;
 
-	if (fb_va == 0) {
-		fb_va = (uint64_t)ml_io_map_wcomb((vm_offset_t)fb_pa, (vm_size_t)fb_size);
-	}
-	if (fb_va == 0) {
+	if ((g0245d_ttbr0_loader == 0) || (n <= 0)) {
 		return;
 	}
 
-	for (i = 0; i < (unsigned int)n; i++) {
-		uint64_t       off = (uint64_t)(700 + i * 60) * rowbytes;
-		uint64_t       k;
-		unsigned char *p   = (unsigned char *)(uintptr_t)(fb_va + off);
+	__asm__ __volatile__("mrs %0, ttbr0_el1" : "=r"(ttbr0_now));
+
+	__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(g0245d_ttbr0_loader) : "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
+	__asm__ __volatile__("tlbi vmalle1" ::: "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
+
+	for (i = 0; i < n; i++) {
+		volatile unsigned int *p = (volatile unsigned int *)(unsigned long)
+		    (0xC3401000UL + (unsigned long)(700 + i * 45) * 0xCA8UL);
+		unsigned long k;
 
-		for (k = 0; k < 40ULL * rowbytes; k++) {
-			p[k] = 0xFF;
+		for (k = 0; k < (30UL * 0xCA8UL / 4UL); k++) {
+			p[k] = 0xFFFFFFFFU;
 		}
 	}
+
+	__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(ttbr0_now) : "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
+	__asm__ __volatile__("tlbi vmalle1" ::: "memory");
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	__asm__ __volatile__("isb" ::: "memory");
 }
 
