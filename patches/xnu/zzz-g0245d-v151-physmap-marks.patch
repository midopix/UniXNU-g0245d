diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -3377,21 +3377,23 @@
 void
 g0245d_fb_mark(int n)
 {
-	unsigned char *base;
-	unsigned int   i, y, width;
+	/* v151: paint through the kernel physmap; the vinfo.v_baseaddr VA never
+	 * showed a single bar, while v133's physmap bands (gVirtBase+pa-gPhysBase)
+	 * did light after arm_vm_init. fb phys 0x83401000, 24bpp, stride 0xCA8. */
+	const uint64_t fb_pa    = 0x83401000ULL;
+	const uint64_t rowbytes = 0xCA8ULL;   /* 1080 px * 3 bytes (24bpp) */
+	uint64_t       va;
+	unsigned int   i;
 
-	if ((vinfo.v_baseaddr == 0) || (vinfo.v_rowbytes == 0) || (vinfo.v_height == 0)) {
-		return;
-	}
-
-	base  = (unsigned char *)(uintptr_t)vinfo.v_baseaddr;
-	width = vinfo.v_rowbytes;
+	va = gVirtBase + (fb_pa - gPhysBase);
 
 	for (i = 0; i < (unsigned int)n; i++) {
-		unsigned int y0 = 1000 + i * 80;
+		uint64_t       off = (uint64_t)(1000 + i * 80) * rowbytes;
+		uint64_t       k;
+		unsigned char *p   = (unsigned char *)(uintptr_t)(va + off);
 
-		for (y = y0; (y < (y0 + 40)) && (y < vinfo.v_height); y++) {
-			memset(base + (unsigned long)y * width, 0xFF, width);
+		for (k = 0; k < 40ULL * rowbytes; k++) {
+			p[k] = 0xFF;
 		}
 	}
 }
