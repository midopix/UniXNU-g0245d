 	/*
 	 * G0245D v148: the kPEAcquireScreen call above brings up the graphics
@@ -735,15 +736,16 @@
 	 * point on is visible.
 	 */
 	switch_to_video_console();
+	g0245d_fb_mark(4);	/* v151: after switch_to_video_console */
 	initialize_screen(NULL, kPETextScreen);
-	g0245d_fb_mark(4);
+	g0245d_fb_mark(5);
 
 	/*
 	 *	Initialize the shared region module.
 	 */
 	vm_commpage_init();
 	vm_commpage_text_init();
-	g0245d_fb_mark(5);
+	g0245d_fb_mark(6);
 
 #if CONFIG_MACF
 	kernel_bootstrap_log("mac_policy_initmach");
