 void arm_init(boot_args * args);
 
+/*
+ * g0245d v133: paint a band AFTER the bootstrap translation tables are gone.
+ * g0245d_paint_stage() writes VA 0xC3401000, which only exists in the TTBR0
+ * bootstrap (V=P) table; arm_vm_init() switches TTBR0 to invalid_ttep and then
+ * drops the bootstrap tables, so any later write to that VA faults. Route the
+ * post-VM marks through the kernel physmap instead (gVirtBase + pa - gPhysBase).
+ */
+static void
+g0245d_paint_stage_vm(int index)
+{
+	extern vm_offset_t gVirtBase;
+	extern vm_offset_t gPhysBase;
+	const uint64_t fb_pa    = 0x83401000ULL;
+	const uint64_t rowbytes = 0xCA8ULL;
+	uint64_t       va, off, n;
+	uint32_t      *p;
+	int            h;
+
+	off = (uint64_t)((index >= 13) ? (700 + 32 * (index - 13)) : (200 + 64 * index)) * rowbytes;
+	h   = (index >= 13) ? 16 : 32;
+	va  = (uint64_t)gVirtBase + (fb_pa - (uint64_t)gPhysBase);
+	p   = (uint32_t *)(uintptr_t)(va + off);
+	n   = (uint64_t)h * rowbytes / 4;
+	while (n--) {
+		*p++ = 0xFFFFFFFFu;
+	}
+}
+
+/*
+ * g0245d v140: white-band stage marks (v139's colour coding retired).
+ *
+ * The v139 photo answered two questions at once. The white band of stage 24
+ * (fb row 1052) WAS on screen at 45% height - so PE_create_console() had
+ * returned - but the flat blue fill had been replaced by a magenta grid
+ * texture: the vc console rewrites the framebuffer with a pixel format that
+ * does not match this panel, and any colour fill is destroyed by it. A band
+ * painted with all-0xFF bytes reads as white under EVERY pixel format, so
+ * the band geometry (rowbytes 0xCA8, verified by v137's photo) is the only
+ * trustworthy channel. Each stage paints one white band; bands accumulate,
+ * the highest-numbered band on screen names the stage.
+ *
+ *   21 arm_vm_init call site   22 arm_vm_init returned    23 serial_init
+ *   24 PE_create_console       25 before machine_startup
+ *   26 PE_init_printf          27 cpu_machine_idle_init   28 PE_init_platform
+ *   29 ml_map_cpu_pio          30 cpu_timebase_init       31 kptimer_curcpu_up
+ *   32 PE_init_cpu             33 fiq_context_init        34 DT dram-base/size
+ */
+#define G0245D_FB_PA        0x83401000ULL
+#define G0245D_FB_ROWBYTES  0xCA8ULL
+#define G0245D_FB_ROWS      1920ULL
+
+/* Before arm_vm_init(): framebuffer lives at its bootstrap VA (V=P window). */
+static void
+g0245d_mark_va(int index)
+{
+	extern void g0245d_paint_stage(int index);
+
+	g0245d_paint_stage(index);
+}
+
+/* After arm_vm_init(): reach the framebuffer through the kernel physmap.
+ * Repaints the whole ladder 13..index: band 21 was painted pre-vm_init on
+ * the bootstrap VA and the vc console clear erases it, and later console
+ * text can punch holes into any band. Repainting keeps the ladder complete
+ * so the read-out stays a continuous chain. */
+static void
+g0245d_mark_vm(int index)
+{
+	int i;
+
+	for (i = 13; i <= index; i++) {
+		g0245d_paint_stage_vm(i);
+	}
+}
