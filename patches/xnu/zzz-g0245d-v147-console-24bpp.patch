diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index 0318f49..5a1c95a 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -444,6 +444,13 @@ PE_init_platform(boolean_t vm_initialized, void *args)
 				PE_state.video.v_width = g0245d_w;
 			}
 		}
+		/* G0245D v147: the panel is 24bpp RGB888. The boot shim reports
+		 * depth 32; force 24 so the video console takes the 24bpp path, and
+		 * derive v_width from the stride at 3 bytes/pixel (1080). */
+		PE_state.video.v_depth = 24;
+		if (PE_state.video.v_rowBytes) {
+			PE_state.video.v_width = PE_state.video.v_rowBytes / 3;
+		}
 		PE_state.video.v_rotate = (
 			((boot_args_ptr->Video.v_depth >> kBootVideoDepthRotateShift) & kBootVideoDepthMask) +    // rotation
 			((boot_args_ptr->Video.v_depth >> kBootVideoDepthBootRotateShift)  & kBootVideoDepthMask) // add extra boot rotation
