--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -780,7 +780,16 @@
 extern unsigned char iso_font[256 * 16];
 
 #define G0245D_FB_PA        0x83401000UL
-#define G0245D_FB_SIZE      0x200000UL
+/* G0245D v190: the ml_io_map length must cover the WHOLE scanout. With
+ * 0x200000 (2 MiB) the map ends at fb row ~643, but fbcon row 0 lives at
+ * fb rows 928..959 (offset 3,006,720) - outside the mapping. fbcon_init()
+ * blanks row 0 first, so the very first pixel store took a data abort on
+ * unmapped device memory, before switch_to_serial_console() and with no
+ * working console: a perfectly silent death. The v189 photo shows exactly
+ * that - the pre-fault frame (loader + paint_stage/fb_mark bands) frozen,
+ * not one fbcon pixel on screen. The loader handoff line itself reports
+ * the reserved display region as 0x23ff000; map that much. */
+#define G0245D_FB_SIZE      0x23FF000UL
 #define G0245D_FB_STRIDE    0xCA8UL      /* 3240 == 1080 px * 3 bytes */
 #define G0245D_FB_BPP       3
 #define G0245D_FB_WIDTH     1080
