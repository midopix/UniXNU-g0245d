 	g0245d_fb_mark(2);
 	/*
-	 * G0245D v163: v153 left a g0245d_fb_block(600, 1400) + g0245d_halt() pair
-	 * right here - BEFORE initialize_screen(). It was never removed, so every
-	 * build from v153 to v162 died or froze at this exact line and the kernel
-	 * never once reached the kPEAcquireScreen clear, let alone anything after
-	 * it. That single leftover invalidated the readings of six versions.
-	 * Removed: let the kernel through.
+	 * G0245D v166: SKIP the kPEAcquireScreen clear.
+	 *
+	 * v164 proved the panel can be painted after arm_vm_init (photo: two solid
+	 * white blocks). v165 then let the kernel run past arm_init with no halt,
+	 * and the panel went black "after a little while" - with the white block
+	 * still visible in the photo taken just before. That points squarely at
+	 * this call: initialize_screen(NULL, kPEAcquireScreen) brings up the
+	 * graphics *progress* screen, and vc_progress_set(TRUE) inside it wipes the
+	 * entire framebuffer with the progress background. Since the console is
+	 * not serial, gc_enable(FALSE) also sets disableConsoleOutput = TRUE, so
+	 * nothing is ever drawn back. Net effect: the white blocks we painted in
+	 * arm_init are erased here and the panel stays black forever, even though
+	 * the kernel keeps running.
+	 *
+	 * Skipping it keeps whatever we painted in place, at the cost of not
+	 * having a progress screen. If the white block survives to the end, this
+	 * call is confirmed as the eraser and we can drive the panel ourselves
+	 * from here on.
 	 */
-	initialize_screen(NULL, kPEAcquireScreen);
+	/* initialize_screen(NULL, kPEAcquireScreen); */
 	g0245d_fb_mark(3);	/* v151: drawn AFTER the kPEAcquireScreen clear */
 
