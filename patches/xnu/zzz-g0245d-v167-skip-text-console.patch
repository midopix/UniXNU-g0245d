 	g0245d_fb_mark(3);	/* v151: drawn AFTER the kPEAcquireScreen clear */
 
 	/*
-	 * G0245D v148: the kPEAcquireScreen call above brings up the graphics
-	 * *progress* screen.  Because the console is not serial, gc_enable(FALSE)
-	 * inside it sets disableConsoleOutput = TRUE, and vc_progress_set() wipes
-	 * the framebuffer with the progress background.  On this board the net
-	 * effect is a completely black panel with no kernel output whatsoever,
-	 * which looks exactly like a dead boot even though the kernel keeps
-	 * running (the white bands drawn in arm_init are wiped here, which is why
-	 * they only "flash" for one frame).
+	 * G0245D v167: v166 skipped the kPEAcquireScreen clear and the panel STILL
+	 * went black. So that clear is not the eraser (or at least not the only
+	 * one). The remaining suspects in this window are the two calls below:
+	 * switch_to_video_console() and initialize_screen(NULL, kPETextScreen) -
+	 * the latter does another full mode set, and on a board where we do not
+	 * own the display driver it can just as easily wipe or reconfigure the
+	 * panel.
 	 *
-	 * Force the on-screen text console back on so every kprintf from this
-	 * point on is visible.
+	 * Skip both. If the panel then keeps whatever arm_init painted, the eraser
+	 * was one of these; if it still goes black, nothing in this function is
+	 * responsible and the remaining explanation is that the DISPLAY ITSELF is
+	 * switched off later (MDP5/DSI clocks or power), which changes the whole
+	 * direction of the investigation.
 	 */
-	switch_to_video_console();
+	/* switch_to_video_console(); */
 	g0245d_fb_mark(4);	/* v151: after switch_to_video_console */
-	initialize_screen(NULL, kPETextScreen);
