diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2150,6 +2150,97 @@
 	arm_set_user_tbi();
 
 	arm_vm_physmap_init(args);
+
+	/*
+	 * G0245D v172: install a dedicated framebuffer mapping into the TTBR1
+	 * tables while the bootstrap TTBR0 is still live.
+	 *
+	 * Technique borrowed from the G0345D port (Yuanchu000I/UniXUN-g0345d:
+	 * zzz-g0345d-v169-172-fb-slot.patch, v178-bootstrap-l2-va,
+	 * v179-full-framebuffer-slot). Borrowing TTBR0 at paint time works but
+	 * costs two full TLB invalidations per paint and only survived because
+	 * the loader tables happened to still be intact; this installs a
+	 * permanent mapping instead.
+	 *
+	 * Three traps that port documented and we inherit:
+	 *  1. alloc_ptpage() does NOT zero the page - bzero() it explicitly or
+	 *     the neighbouring descriptors hold garbage.
+	 *  2. Still on the bootstrap TTBR0 here, phystokv() returns the new (not
+	 *     yet live) TTBR1 aperture, so reach an existing L2 page with the
+	 *     gVirtBase/gPhysBase identity math instead.
+	 *  3. The descriptor physical base is 2 MB aligned while the framebuffer
+	 *     starts part-way into it, so the usable VA must add
+	 *     (fb_pa - block_base) or every write lands megabytes away.
+	 *
+	 * Attribute is CACHE_ATTRINDX_DISABLE (device, non-cacheable) to match
+	 * the bootstrap 1 GB block in start.s (TTE 0x8000060D, ATTR disable) -
+	 * the only mapping that has ever put a pixel on this panel. A cacheable
+	 * mapping is exactly why the physmap never reached MDP5.
+	 */
+	{
+		extern vm_offset_t g0245d_fb_va;
+		const uint64_t fb_pa      = 0x83401000ULL;
+		const uint64_t fb_bytes   = 3240ULL * 1920ULL;
+		const uint64_t block_base = fb_pa & ARM_TTE_BLOCK_L2_MASK;
+		const uint64_t fb_offset  = fb_pa - block_base;
+		const unsigned int fb_blocks = (unsigned int)
+		    ((fb_offset + fb_bytes + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE);
+		vm_offset_t fb_slot = (vm_offset_t)
+		    ((VM_MAX_KERNEL_ADDRESS - 0x10000000ULL) & ~(uint64_t)ARM_TT_L2_OFFMASK);
+		tt_entry_t *l1_tte_fb;
+		tt_entry_t *l2_tte_fb;
+		vm_offset_t l2_page;
+		unsigned int l2_index;
+		unsigned int i;
+
+		l1_tte_fb = cpu_tte + ((fb_slot & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
+		l2_index = (unsigned int)((fb_slot & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+
+		if ((l2_index + fb_blocks) > (ARM_PGBYTES / sizeof(tt_entry_t))) {
+			fb_slot -= (vm_offset_t)ARM_TT_L2_SIZE * fb_blocks;
+			l1_tte_fb = cpu_tte + ((fb_slot & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
+			l2_index = (unsigned int)((fb_slot & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+		}
+
+		if (*l1_tte_fb == ARM_TTE_EMPTY) {
+			l2_page = alloc_ptpage(TRUE);
+			bzero((void *)l2_page, ARM_PGBYTES);
+			*l1_tte_fb = (kvtophys(l2_page) & ARM_TTE_TABLE_MASK) |
+			    ARM_TTE_TYPE_TABLE | ARM_TTE_VALID |
+			    ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA);
+		} else {
+			pmap_paddr_t l2_pa = (pmap_paddr_t)((*l1_tte_fb) & ARM_TTE_TABLE_MASK);
+
+			l2_page = (vm_offset_t)(l2_pa - (pmap_paddr_t)gPhysBase +
+			    (vm_offset_t)gVirtBase);
+		}
+
+		l2_tte_fb = (tt_entry_t *)l2_page + l2_index;
+
+		if ((*l1_tte_fb & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) ==
+		    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+			for (i = 0; i < fb_blocks; i++) {
+				if (l2_tte_fb[i] != ARM_TTE_EMPTY) {
+					break;
+				}
+			}
+			if (i == fb_blocks) {
+				for (i = 0; i < fb_blocks; i++) {
+					uint64_t block_pa = block_base +
+					    (uint64_t)i * (uint64_t)ARM_TT_L2_SIZE;
+
+					l2_tte_fb[i] = (block_pa & ARM_TTE_BLOCK_L2_MASK) |
+					    ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID |
+					    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_NX |
+					    ARM_TTE_BLOCK_AP(0) |
+					    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+					    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE);
+				}
+				g0245d_fb_va = (vm_offset_t)(fb_slot + (vm_offset_t)fb_offset);
+			}
+		}
+	}
+
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 #if XNU_MONITOR
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
