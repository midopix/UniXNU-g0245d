  *		Function:		Runs on the boot CPU, once, on entry from iBoot.
  */
 
+/*
+ * G0245D v172: kernel VA of the framebuffer, installed by arm_vm_init() into
+ * the TTBR1 tables (device/non-cacheable, 2 MB blocks). 0 means "not mapped",
+ * in which case every painter must do nothing.
+ */
+vm_offset_t g0245d_fb_va = 0;
+
 __startup_func
 void
 arm_init(
@@ -382,6 +389,7 @@
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+
 	/*
 	 * g0245d v122: stage 7 - reached the C entry point (arm_init). Paint a
 	 * band through the post-MMU framebuffer mapping to prove the kernel got
@@ -674,40 +682,23 @@
 	arm_vm_init(xmaxmem, args);
 
 	/*
-	 * G0245D v169: paint rows 700..972 white through the borrowed loader table
-	 * (exactly what v164 proved works) but WITHOUT halting this time. The point
-	 * is to leave something on the panel that we can watch while the kernel
-	 * runs on, so that a later halt shows whether the MMSS replay revived MDP5.
+	 * G0245D v172: paint rows 700..972 through the permanent TTBR1 framebuffer
+	 * slot that arm_vm_init() just installed (g0245d_fb_va). No TTBR0
+	 * borrowing, no TLB churn - just a device-attribute mapping that always
+	 * reaches the panel.
 	 */
 	{
-		extern uint64_t g0245d_ttbr0_loader;
-		uint64_t ttbr0_now = 0;
-
-		__asm__ __volatile__("mrs %0, ttbr0_el1" : "=r"(ttbr0_now));
-
-		__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(g0245d_ttbr0_loader) : "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
-		__asm__ __volatile__("tlbi vmalle1" ::: "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
-
-		{
-			volatile unsigned int *p = (volatile unsigned int *)(unsigned long)
-			    (0xC3401000UL + 700UL * 0xCA8UL);
-			unsigned long n;
+		extern vm_offset_t g0245d_fb_va;
+		volatile unsigned int *p;
+		unsigned long n;
 
+		if (g0245d_fb_va != 0) {
+			p = (volatile unsigned int *)(unsigned long)
+			    (g0245d_fb_va + 700UL * 0xCA8UL);
 			for (n = 0; n < (272UL * 0xCA8UL / 4UL); n++) {
 				p[n] = 0xFFFFFFFFU;
 			}
 		}
-
-		__asm__ __volatile__("msr ttbr0_el1, %0" :: "r"(ttbr0_now) : "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
-		__asm__ __volatile__("tlbi vmalle1" ::: "memory");
-		__asm__ __volatile__("dsb sy" ::: "memory");
-		__asm__ __volatile__("isb" ::: "memory");
 	}
 
 	if (debug_boot_arg) {
diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
