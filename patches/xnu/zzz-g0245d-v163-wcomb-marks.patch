diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -722,8 +722,14 @@
 	 * This will start displaying progress to the user, start as early as possible
 	 */
 	g0245d_fb_mark(2);
-	g0245d_fb_block(600, 1400);	/* v153: prove we reach the kPEAcquireScreen call */
-	g0245d_halt();			/* v153: freeze BEFORE the clear */
+	/*
+	 * G0245D v163: v153 left a g0245d_fb_block(600, 1400) + g0245d_halt() pair
+	 * right here - BEFORE initialize_screen(). It was never removed, so every
+	 * build from v153 to v162 died or froze at this exact line and the kernel
+	 * never once reached the kPEAcquireScreen clear, let alone anything after
+	 * it. That single leftover invalidated the readings of six versions.
+	 * Removed: let the kernel through.
+	 */
 	initialize_screen(NULL, kPEAcquireScreen);
 	g0245d_fb_mark(3);	/* v151: drawn AFTER the kPEAcquireScreen clear */
 
