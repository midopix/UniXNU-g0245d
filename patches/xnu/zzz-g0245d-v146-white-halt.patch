+	/* G0245D v146: halt right after the v145 full-white fill so the screen
+	 * stays permanently white (or permanently black) instead of flashing
+	 * white for one frame. Removes the transient: white => fb writes to
+	 * 0xC3401000 really reach the panel; black => they do not. */
+	for (;;) {
+		__asm__ __volatile__("wfe" ::: "memory");
+	}
