[Unit]
Description=G0245D device-driven auto-flash watcher (WorkBuddy sandbox bypass)
After=default.target

[Service]
Type=simple
ExecStart=/bin/bash <G0245D_ROOT>/linux/flash-watcher.sh
Restart=always
RestartSec=3
StandardOutput=append:<G0245D_ROOT>/linux/.flash-watcher.log
StandardError=append:<G0245D_ROOT>/linux/.flash-watcher.log

[Install]
WantedBy=default.target
